From 4be58bc989a2d8ee53fbdb50336d1467442f3248 Mon Sep 17 00:00:00 2001
From: galadriel1402 <galadriel1402@gmail.com>
Date: Mon, 8 Dec 2025 23:43:22 +0800
Subject: [PATCH] Revert "drivers: Inherit KernelSU-Next via clone"

This reverts commit 173eb6c.
---
 drivers/Kconfig  | 2 --
 drivers/Makefile | 2 --
 drivers/kernelsu | 1 -
 3 files changed, 5 deletions(-)
 delete mode 120000 drivers/kernelsu

diff --git a/drivers/Kconfig b/drivers/Kconfig
index 74e11a7d5a4b..43377a3acb97 100644
--- a/drivers/Kconfig
+++ b/drivers/Kconfig
@@ -225,6 +225,4 @@ source "drivers/sensors/Kconfig"
 
 source "drivers/esoc/Kconfig"
 
-source "drivers/kernelsu/Kconfig"
-
 endmenu
diff --git a/drivers/Makefile b/drivers/Makefile
index d9d5779bf30d..4a067525bbdc 100644
--- a/drivers/Makefile
+++ b/drivers/Makefile
@@ -191,5 +191,3 @@ obj-$(CONFIG_ESOC)              += esoc/
 # GNSS driver
 obj-$(CONFIG_GNSS_SIRF)		+= gnsssirf/
 obj-$(CONFIG_GNSS)		+= gnss/
-
-obj-$(CONFIG_KSU) += kernelsu/
diff --git a/drivers/kernelsu b/drivers/kernelsu
deleted file mode 120000
index 9e51d0d62734..000000000000
--- a/drivers/kernelsu
+++ /dev/null
@@ -1 +0,0 @@
-../KernelSU/kernel
\ No newline at end of file
-- 
2.51.0
